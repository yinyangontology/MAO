    <!-- http://purl.ontochina.org/MAO_0000001 -->

    <owl:Class rdf:about="http://purl.ontochina.org/MAO_0000001">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
        <owl:disjointWith rdf:resource="http://purl.ontochina.org/MAO_0000002"/>
        <obo:IAO_0000115 xml:lang="zh">经脉和络脉的总称,是人体运行气血、联络脏腑、沟通内外、贯穿上下的通路。</obo:IAO_0000115>
        <obo:IAO_0000119>针灸学通用术语 GB/T 30232—2013</obo:IAO_0000119>
        <rdfs:label xml:lang="en">meridian and collateral</rdfs:label>
        <rdfs:label xml:lang="zh">经络</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.ontochina.org/MAO_0000002 -->

    <owl:Class rdf:about="http://purl.ontochina.org/MAO_0000002">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
        <obo:IAO_0000115 xml:lang="zh">针灸刺激及诊察的人体特定部位。</obo:IAO_0000115>
        <obo:IAO_0000119>经穴名称与定位 GBT 12346-2021</obo:IAO_0000119>
        <rdfs:label xml:lang="en">point</rdfs:label>
        <rdfs:label xml:lang="zh">腧穴</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.ontochina.org/MAO_0000003 -->

    <owl:Class rdf:about="http://purl.ontochina.org/MAO_0000003">
        <rdfs:subClassOf rdf:resource="http://purl.ontochina.org/MAO_0000001"/>
        <obo:IAO_0000115 xml:lang="zh">人体经络系统的主干,全身气血运行的主要通路。包括十二经脉和奇经八脉。</obo:IAO_0000115>
        <obo:IAO_0000119>针灸学通用术语 GB/T 30232—2013</obo:IAO_0000119>
        <rdfs:label xml:lang="en">meridian vessel</rdfs:label>
        <rdfs:label xml:lang="zh">经脉</rdfs:label>
    </owl:Class>
    


