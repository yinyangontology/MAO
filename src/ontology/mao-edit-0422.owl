        <obo:IAO_0000115 xml:lang="zh">阴脉之海 奇经八脉之一。起于小腹内，下出会阴，沿腹上达咽喉，环绕口唇，止于目下。</obo:IAO_0000115>
        <obo:IAO_0000119>针灸学通用术语 GB/T 30232—2013</obo:IAO_0000119>
        <rdfs:label xml:lang="en">conception vessel</rdfs:label>
        <rdfs:label xml:lang="zh">任脉</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.ontochina.org/MAO_0000023 -->

    <owl:Class rdf:about="http://purl.ontochina.org/MAO_0000023">
        <rdfs:subClassOf rdf:resource="http://purl.ontochina.org/MAO_0000005"/>
        <obo:IAO_0000115 xml:lang="zh">经脉之海 奇经八脉之一。起于小腹内，下出会阴，上行脊内，沿腹两侧，上达咽喉，环绕口唇而终。</obo:IAO_0000115>
        <obo:IAO_0000119>针灸学通用术语 GB/T 30232—2013</obo:IAO_0000119>
        <rdfs:label xml:lang="en">thoroughfare vessel</rdfs:label>
        <rdfs:label xml:lang="zh">冲脉</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.ontochina.org/MAO_0000024 -->

    <owl:Class rdf:about="http://purl.ontochina.org/MAO_0000024">
        <rdfs:subClassOf rdf:resource="http://purl.ontochina.org/MAO_0000005"/>
        <obo:IAO_0000115 xml:lang="zh">奇经八脉之一。起于季胁，斜向横行，绕腰腹一周。</obo:IAO_0000115>
        <obo:IAO_0000119>针灸学通用术语 GB/T 30232—2013</obo:IAO_0000119>
        <rdfs:label xml:lang="en">belt vessel</rdfs:label>
        <rdfs:label xml:lang="zh">带脉</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.ontochina.org/MAO_0000025 -->

    <owl:Class rdf:about="http://purl.ontochina.org/MAO_0000025">
        <rdfs:subClassOf rdf:resource="http://purl.ontochina.org/MAO_0000005"/>
        <obo:IAO_0000115 xml:lang="zh">奇经八脉之一。起于足跟内侧直上沿大腿内侧，过阴部，沿腹、胸内侧入锁骨上窝，经人迎，过鼻旁至目内眦。</obo:IAO_0000115>
        <obo:IAO_0000119>针灸学通用术语 GB/T 30232—2013</obo:IAO_0000119>
        <rdfs:label xml:lang="en">yin heel vessel</rdfs:label>
        <rdfs:label xml:lang="zh">阴跷脉</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.ontochina.org/MAO_0000026 -->

    <owl:Class rdf:about="http://purl.ontochina.org/MAO_0000026">
        <rdfs:subClassOf rdf:resource="http://purl.ontochina.org/MAO_0000005"/>
        <obo:IAO_0000115 xml:lang="zh">奇经八脉之一。起于足跟外侧，沿股外侧和胁后上肩，过颈挟口角，入目内眦再上行至额。</obo:IAO_0000115>
        <obo:IAO_0000119>针灸学通用术语 GB/T 30232—2013</obo:IAO_0000119>
        <rdfs:label xml:lang="en">yang heel vessel</rdfs:label>
        <rdfs:label xml:lang="zh">阳跷脉</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.ontochina.org/MAO_0000027 -->

    <owl:Class rdf:about="http://purl.ontochina.org/MAO_0000027">
        <rdfs:subClassOf rdf:resource="http://purl.ontochina.org/MAO_0000005"/>
        <obo:IAO_0000115 xml:lang="zh">奇经八脉之一。起于足跟内侧，沿大腿内侧上行至腹部，与足太阴经相合，过胸部与任脉会于颈部。</obo:IAO_0000115>
        <obo:IAO_0000119>针灸学通用术语 GB/T 30232—2013</obo:IAO_0000119>
        <rdfs:label xml:lang="en">yin link vessel</rdfs:label>
        <rdfs:label xml:lang="zh">阴维脉</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.ontochina.org/MAO_0000028 -->

    <owl:Class rdf:about="http://purl.ontochina.org/MAO_0000028">
        <rdfs:subClassOf rdf:resource="http://purl.ontochina.org/MAO_0000005"/>
        <obo:IAO_0000115 xml:lang="zh">奇经八脉之一。起于足跟外侧，上经外踝，沿足少阳经上行髋关节，经胁肋后侧，从腋后上肩，至前额，达项后，合于督脉。</obo:IAO_0000115>
        <obo:IAO_0000119>针灸学通用术语 GB/T 30232—2013</obo:IAO_0000119>
        <rdfs:label xml:lang="en">yang link vessel</rdfs:label>
        <rdfs:label xml:lang="zh">阳维脉</rdfs:label>
    </owl:Class>
    


